<?xml version="1.0" encoding="utf-8"?>
<map name="UAVViewerMap" type="geocentric">

    <options>
        <terrain vertical_scale="1.0"/>
    </options>

    <!-- OpenStreetMap Harita Altligi -->
    <image name="OpenStreetMap" driver="xyz">
        <url>https://tile.openstreetmap.org/{z}/{x}/{y}.png</url>
        <profile>spherical-mercator</profile>
    </image>

    <!-- ArcGIS Renkli Uydu Kaplamasi -->
    <image name="World_Imagery" driver="xyz">
        <url>https://services.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}</url>
        <profile>spherical-mercator</profile>
    </image>
    <GDALElevation name="SRTM N39E032">
        <url>srtm_data/N39E032.hgt</url>
    </GDALElevation>

    <GDALElevation name="SRTM N39E033">
        <url>srtm_data/N39E033.hgt</url>
    </GDALElevation>

    <GDALElevation name="SRTM N40E032">
        <url>srtm_data/N40E032.hgt</url>
    </GDALElevation>

    <GDALElevation name="SRTM N40E033">
        <url>srtm_data/N40E033.hgt</url>
    </GDALElevation>

</map>
